---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import { fetchPosts, fetchPostBySlug, lexicalToHtml, getMediaUrl } from "../../utils/payload";

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props;
const post = await fetchPostBySlug(slug);

if (!post) {
  return Astro.redirect("/blog");
}

const htmlContent = lexicalToHtml(post.content);
const coverUrl = getMediaUrl(post.cover?.url);

const categoryColors: Record<string, string> = {
  Website: "indigo",
  Otomasi: "amber",
  AI: "indigo",
};
const color = categoryColors[post.category] ?? "indigo";
---

<Layout
  title={`${post.title} - KarsaHub Blog`}
  description={post.excerpt}
  type="article"
  articleDate={new Date(post.date)}
  ogImage={coverUrl || `/og/${slug}.png`}
  keywords={`${post.category}, KarsaHub, ${post.title}`}
>
  <Navbar client:load />
  <div class="post-page">
    <div class="post-hero">
      <div class="container">
        <a href="/blog" class="post-back">&larr; Semua Artikel</a>
        <div class="post-hero-center">
          <div class={`post-cat post-cat-${color}`}>{post.category}</div>
          <h1 class="post-title">{post.title}</h1>
          <p class="post-date">
            {new Date(post.date).toLocaleDateString("id-ID", {
              day: "numeric", month: "long", year: "numeric",
            })}
          </p>
        </div>
      </div>
    </div>

    {coverUrl && (
      <div class="container">
        <div class="post-cover">
          <img src={coverUrl} alt={post.cover?.alt || post.title} loading="lazy" />
        </div>
      </div>
    )}

    <div class="container post-content">
      <div class="post-body" set:html={htmlContent} />

      <div class="post-cta">
        <p class="post-cta-text">Tertarik implementasi solusi ini untuk bisnis Anda?</p>
        <a href="/#kontak" class="btn btn-primary btn-lg">Konsultasi Gratis</a>
      </div>
    </div>
  </div>
</Layout>

<style>
.post-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 80px;
}

.post-hero {
  padding: 120px 0 56px;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 56px;
}

.post-back {
  display: inline-flex;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-text-muted);
  text-decoration: none;
  margin-bottom: 32px;
  transition: color 150ms;
}
.post-back:hover { color: var(--color-text-primary); }

.post-hero-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  max-width: 720px;
  margin: 0 auto;
}

.post-cat {
  display: inline-flex;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  border-left: 2px solid var(--color-accent-500);
  background: none;
  color: var(--color-accent-600);
  padding-left: 10px;
  border-radius: 0;
}
.post-cat-indigo { color: var(--color-accent-600); border-color: var(--color-accent-500); }
.post-cat-amber  { color: var(--color-accent-600); border-color: var(--color-accent-500); }

.post-title {
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.post-date { font-size: 13px; color: var(--color-text-muted); }

.post-cover {
  max-width: 720px;
  margin: 0 auto 40px;
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.post-cover img {
  width: 100%;
  height: auto;
  display: block;
}

.post-content { max-width: 720px; }

.post-body {
  font-size: 16px;
  color: var(--color-text-secondary);
  line-height: 1.8;
}
.post-body :global(h2) {
  font-size: 22px;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: -0.01em;
  margin: 40px 0 16px;
}
.post-body :global(h3) {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 28px 0 12px;
}
.post-body :global(h4) {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 24px 0 10px;
}
.post-body :global(p) { margin-bottom: 20px; }
.post-body :global(ul), .post-body :global(ol) {
  padding-left: 24px;
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.post-body :global(li) { color: var(--color-text-secondary); }
.post-body :global(strong) { color: var(--color-text-primary); font-weight: 600; }
.post-body :global(blockquote) {
  border-left: 3px solid var(--color-primary-300);
  padding: 12px 20px;
  margin: 24px 0;
  background: var(--color-primary-50);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  font-style: italic;
}
.post-body :global(figure) {
  margin: 24px 0;
}
.post-body :global(figure img) {
  width: 100%;
  border-radius: var(--radius-md);
}
.post-body :global(a) {
  color: var(--color-primary-600);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.post-body :global(a:hover) {
  color: var(--color-primary-800);
}

.post-cta {
  margin-top: 56px;
  padding: 40px;
  background: var(--color-primary-50);
  border: 1px solid var(--color-primary-100);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.post-cta-text {
  font-size: 16px;
  font-weight: 500;
  color: var(--color-text-primary);
}
</style>
