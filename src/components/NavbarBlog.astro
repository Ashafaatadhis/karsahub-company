---
---

<nav class="blog-nav">
  <div class="container nav-inner-blog">
    <a href="/" class="logo">
      Karsa<span class="logo-hub">Hub</span>
    </a>
    <div class="blog-nav-links">
      <a href="/#layanan">Layanan</a>
      <a href="/#cara-kerja">Cara Kerja</a>
      <a href="/#portofolio">Portofolio</a>
      <a href="/#harga">Harga</a>
      <a href="/blog" class:list={["blog-nav-active", { hidden: Astro.url.pathname === "/blog" || Astro.url.pathname === "/blog/" }]}>Blog</a>
    </div>
    <a href="/#kontak" class="btn btn-nav-cta">Mulai Proyek</a>
  </div>
</nav>

<style>
.blog-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(250, 250, 250, 0.88);
  backdrop-filter: blur(14px) saturate(160%);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  border-bottom: 1px solid var(--color-border);
  box-shadow: 0 1px 0 0 var(--color-border), var(--shadow-xs);
}

[data-theme="dark"] .blog-nav {
  background: rgba(22, 22, 30, 0.88);
}

.nav-inner-blog {
  display: flex;
  align-items: center;
  height: 64px;
  gap: 32px;
}

.blog-nav-links {
  display: flex;
  gap: 28px;
  flex: 1;
}

.blog-nav-links a {
  font-size: 14px;
  font-weight: 450;
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color 150ms;
}
.blog-nav-links a:hover { color: var(--color-text-primary); }

.blog-nav-active {
  color: var(--color-primary-800) !important;
  font-weight: 500 !important;
}

.hidden { display: none; }

@media (max-width: 768px) {
  .blog-nav-links { display: none; }
  .blog-nav .btn { display: none; }
}
</style>
