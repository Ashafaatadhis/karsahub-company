<style>
.footer {
  background: var(--color-primary-950);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-top: 64px;
}

.footer-inner {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 64px;
  padding-bottom: 48px;
}
@media (max-width: 768px) { .footer-inner { grid-template-columns: 1fr; gap: 40px; } }

.footer-tagline {
  font-size: 13px;
  color: rgba(255,255,255,0.4);
  margin-top: 10px;
  line-height: 1.5;
  font-style: italic;
}

.footer-social {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}
.footer-social a {
  color: rgba(255,255,255,0.4);
  text-decoration: none;
  transition: color 150ms;
}
.footer-social a:hover { color: rgba(255,255,255,0.8); }

.footer-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
@media (max-width: 480px) { .footer-links { grid-template-columns: repeat(2, 1fr); } }

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-col-title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-bottom: 4px;
}

.footer-col a {
  font-size: 14px;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  transition: color 150ms;
}
.footer-col a:hover { color: rgba(255,255,255,0.85); }

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-top: 1px solid rgba(255,255,255,0.06);
  flex-wrap: wrap;
  gap: 8px;
}
.footer-bottom p {
  font-size: 12px;
  color: rgba(255,255,255,0.3);
}
</style>
