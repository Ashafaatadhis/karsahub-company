---
---

<section id="portofolio" class="section has-bottom-glow">
  <div class="section-bottom-glow section-bottom-glow-indigo section-bottom-glow-right" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">Portofolio</div>
      <h2 class="section-title">Karya yang Bicara Sendiri</h2>
      <p class="section-sub">Beberapa proyek yang kami kerjakan untuk klien bisnis lokal Indonesia.</p>
    </div>
    <div class="portfolio-grid">

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project1.jpg" alt="Saraswati Spa Bali" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">Website</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">Saraswati Spa Bali</h3>
          <p class="portfolio-desc">Website spa tradisional Bali dengan nuansa healing dan wellness, bilingual Indonesia-Inggris.</p>
          <a href="https://tumbuhai-tech-spa-bali.vercel.app/" target="_blank" rel="noopener" class="portfolio-link">Lihat Demo &rarr;</a>
        </div>
      </div>

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project2.jpg" alt="ZenSpa Home Service" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">Website</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">ZenSpa Home Service</h3>
          <p class="portfolio-desc">Website spa home service Jakarta dengan paket layanan, testimoni, dan informasi booking yang clean dan profesional.</p>
          <a href="https://tumbuhai-tech-spa.vercel.app/" target="_blank" rel="noopener" class="portfolio-link">Lihat Demo &rarr;</a>
        </div>
      </div>

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project3.jpg" alt="Intervox AI Speech Analysis" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">Web App + AI</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">Intervox - AI Speech Analysis</h3>
          <p class="portfolio-desc">Platform SaaS analisis pidato berbasis AI - upload video, dapat skor, transkrip, dan coaching otomatis.</p>
          <a href="https://capstone-frontend-taupe.vercel.app/" target="_blank" rel="noopener" class="portfolio-link">Lihat Demo &rarr;</a>
        </div>
      </div>

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project4.jpg" alt="Fastorium Warranty Bot" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">Bot Telegram</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">Fastorium - Bot Garansi Telegram</h3>
          <p class="portfolio-desc">Bot Telegram otomatis untuk manajemen garansi produk - cek status, klaim, dan notifikasi pelanggan langsung di Telegram.</p>
          <a href="https://t.me/fastoriumwarranty_bot" target="_blank" rel="noopener" class="portfolio-link">Coba Bot &rarr;</a>
        </div>
      </div>

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project5.jpg" alt="RTM Corndog AI Agent Kosan" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">AI Agent</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">RTM Corndog - AI Agent Kosan</h3>
          <p class="portfolio-desc">AI Agent berbasis LLM untuk manajemen kosan - calon penyewa bisa tanya-jawab otomatis soal ketersediaan kamar, harga, dan fasilitas.</p>
          <a href="https://rtm-corndog.my.id/" target="_blank" rel="noopener" class="portfolio-link">Lihat Demo &rarr;</a>
        </div>
      </div>

      <div class="portfolio-card reveal">
        <div class="portfolio-img">
          <img src="/project/project6.jpg" alt="SansMail Temporary Email" class="portfolio-photo" />
          <div class="portfolio-overlay">
            <span class="portfolio-tag">SaaS</span>
          </div>
        </div>
        <div class="portfolio-info">
          <h3 class="portfolio-title">SansMail - Temporary Email</h3>
          <p class="portfolio-desc">Layanan email sekali pakai dengan inbox realtime via WebSocket - generate email instan untuk registrasi, OTP, dan jaga privasi online.</p>
          <a href="https://sansmail.my.id/" target="_blank" rel="noopener" class="portfolio-link">Lihat Demo &rarr;</a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
@media (max-width: 640px) { .portfolio-grid { grid-template-columns: 1fr; } }

.portfolio-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 200ms ease, transform 200ms ease;
}
.portfolio-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.portfolio-img {
  height: 220px;
  position: relative;
  overflow: hidden;
}
.portfolio-img-1 { background: linear-gradient(135deg, #E0E7FF 0%, #FFFBEB 100%); }
.portfolio-img-2 { background: linear-gradient(135deg, #D1FAE5 0%, #E0E7FF 100%); }
.portfolio-img-3 { background: linear-gradient(135deg, #FDE68A 0%, #E0E7FF 100%); }
.portfolio-img-4 { background: linear-gradient(135deg, #FCE7F3 0%, #FFFBEB 100%); }

.portfolio-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 16px;
  background: linear-gradient(to top, rgba(17,17,17,0.15) 0%, transparent 60%);
}

.portfolio-tag {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  padding: 3px 10px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
}

.portfolio-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.portfolio-info { padding: 20px 24px; }

.portfolio-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 6px;
}

.portfolio-link {
  display: inline-flex;
  margin-top: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-primary-800);
  text-decoration: none;
  transition: color 150ms;
}
.portfolio-link:hover { color: var(--color-primary-600); }

.portfolio-desc {
  font-size: 13px;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
</style>
